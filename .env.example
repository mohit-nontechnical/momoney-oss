# Required for production, optional on localhost in development.
# Username is always owner. Generate a unique password (20+ characters).
APP_PASSWORD=
# Keep this outside the Git repository if importing real data.
MOMONEY_DATA_DIR=.data
# Optional: your own PRIVATE Vercel Blob store and namespace.
BLOB_READ_WRITE_TOKEN=
BLOB_PREFIX=
# Optional Ask: incurs provider usage fees and sends financial context to it.
OPENROUTER_API_KEY=
ASK_MODEL=
# Optional authenticated JSON ingest and summary automation.
INGEST_SECRET=
SUMMARY_SECRET=
